# Local dev uses SQLite. The path resolves relative to prisma/schema.prisma.
DATABASE_URL="file:./prisma/dev.db"

# Any long random string. Signs the dev session cookie.
SESSION_SECRET="change-me"

# For the real deploy, swap DATABASE_URL to the Supabase pooled connection string
# and replace the dev sign-in in src/lib/auth.ts with Supabase magic-link auth.

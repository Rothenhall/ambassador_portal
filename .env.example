# Copy to .env and fill in. Nothing secret belongs in this file.

# Postgres. DATABASE_URL is the pooled connection the app runs on (pgbouncer-compatible);
# DIRECT_URL is the session connection used only for migrations.
# Local example: postgresql://postgres:postgres@localhost:5432/campus_circle?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Unused at runtime: sessions are random tokens stored as SHA-256 in the Session table, so a
# cookie can be revoked. Kept only so an older deploy's environment does not fail validation.
SESSION_SECRET="change-me"

# Public origin, used when building magic-link URLs. Must be https in production.
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Magic-link and invite delivery. Passwords are checked locally against scrypt hashes and
# never touch this provider; it is only the emailed links that need it. Without a key nothing
# is sent and the app says so out loud: sign-in links and invites are logged to the server
# console instead of being emailed.
RESEND_API_KEY=
RESEND_FROM="Campus Circle <circle@rothenhall.com>"

# Dev-only. Renders the "continue as" account picker on the sign-in page. That picker hands out
# a session for a bare user id with no credential, so the server refuses it unless this is 1
# AND NODE_ENV is not production. Never set it on a deployed instance.
NEXT_PUBLIC_ALLOW_DEV_SIGNIN=1

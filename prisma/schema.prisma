// Campus Circle — data model
//
// Postgres (Supabase) with Prisma migrations under prisma/migrations. DATABASE_URL is the
// pooled connection; DIRECT_URL is the session connection used for DDL.
//
// Enums and JSON are native now. They were plain Strings as a SQLite convenience and that
// cost us: nothing in the database stopped a submission from holding status "banana", and
// every read site had an uncaught JSON.parse. Do not relax these back.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ambassador
  reviewer
  admin
}

// invited = row created by accepting an application, never signed in yet.
enum UserStatus {
  invited
  active
  suspended
}

enum CohortStatus {
  upcoming
  active
  archived
}

enum Tier {
  applicant
  ambassador
  senior
  campus_lead
  alumnus
}

enum Track {
  A
  B
  C
  D
  E
}

enum SubmissionType {
  link
  link_set
  document
  upload
  structured
  roster
  quiz
}

enum SubmissionStatus {
  draft
  submitted
  in_review
  accepted
  changes_requested
  rejected
  missed
}

enum ReviewDecision {
  accepted
  changes_requested
  rejected
}

enum GrantStatus {
  locked
  earned
  claimed
  fulfilled
}

enum FulfilmentType {
  digital
  shipped
  scheduled
  none
}

enum ApplicationStatus {
  pending
  accepted
  rejected
}

model Cohort {
  id        String       @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    CohortStatus @default(active)
  createdAt DateTime     @default(now())

  campuses    Campus[]
  members     Membership[]
  tasks       Task[]
  announcements Announcement[]
  applications Application[]
}

model Campus {
  id       String  @id @default(cuid())
  name     String
  city     String  @default("")
  country  String  @default("India")
  cohortId String
  cohort   Cohort  @relation(fields: [cohortId], references: [id])

  members Membership[]

  @@unique([cohortId, name])
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  role              UserRole   @default(ambassador)
  status            UserStatus @default(active)
  pageUrl           String?
  lane              String?
  bio               String?
  avatarColor       String     @default("#9a7a4a")
  /// scrypt hash, format `scrypt$N$r$p$salt$digest`. Null means the account has no
  /// password and signs in by magic link only.
  passwordHash      String?
  passwordSetAt     DateTime?
  showInDirectory   Boolean    @default(false)
  showOnLeaderboard Boolean    @default(false)
  lastSeenAt        DateTime?
  createdAt         DateTime   @default(now())

  membership    Membership?
  submissions   Submission[]
  reviews       Review[]
  assignedReviews Submission[] @relation("AssignedReviewer")
  ledgerEntries SignalLedger[]
  rewardGrants  RewardGrant[]
  certificate   Certificate?
  moduleProgress ModuleProgress[]
  sessions      Session[]
  decidedApplications Application[] @relation("ApplicationDecider")
  auditEntries  AuditEvent[]
  revokedCertificates Certificate[] @relation("CertificateRevoker")
}

model Membership {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  cohortId    String
  cohort      Cohort   @relation(fields: [cohortId], references: [id])
  campusId    String
  campus      Campus   @relation(fields: [campusId], references: [id])
  tier        Tier     @default(ambassador)
  signalTotal Int      @default(0)
  joinedAt    DateTime @default(now())

  @@index([cohortId])
}

model Task {
  id             String         @id @default(cuid())
  cohortId       String
  cohort         Cohort         @relation(fields: [cohortId], references: [id])
  track          Track
  code           String
  week           Int
  title          String
  summary        String
  briefMd        String
  submissionType SubmissionType
  typeConfig     Json           @default("{}")
  rubric         Json           @default("[]")
  signalValue    Int
  opensAt        DateTime
  dueAt          DateTime
  published      Boolean        @default(true)
  updatedAt      DateTime       @updatedAt @default(now())

  submissions Submission[]

  @@unique([cohortId, code])
  @@index([cohortId, week, published])
}

model Submission {
  id          String            @id @default(cuid())
  taskId      String
  task        Task              @relation(fields: [taskId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  status      SubmissionStatus  @default(draft)
  attemptNo   Int               @default(1)
  content     Json              @default("{}")
  /// The URL that was snapshotted at submit time. Kept separate from content so the
  /// reviewer can tell what we saw from what the ambassador claimed.
  snapshotUrl String?
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  /// Which reviewer took the submission out of the queue. Makes `in_review` a real state
  /// and stops two reviewers working the same attempt.
  assignedReviewerId String?
  assignedReviewer     User?     @relation("AssignedReviewer", fields: [assignedReviewerId], references: [id])
  assignedAt           DateTime?

  reviews     Review[]
  ledgerEntry SignalLedger?

  @@unique([taskId, userId, attemptNo])
  @@index([status, submittedAt])
  @@index([userId])
}

model Review {
  id            String         @id @default(cuid())
  submissionId  String
  submission    Submission     @relation(fields: [submissionId], references: [id])
  reviewerId    String
  reviewer      User           @relation(fields: [reviewerId], references: [id])
  decision      ReviewDecision
  rubricResults Json           @default("[]")
  feedbackMd    String?
  reviewedAt    DateTime       @default(now())

  @@index([submissionId])
  @@index([reviewedAt])
}

model SignalLedger {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  submissionId String?    @unique
  submission   Submission? @relation(fields: [submissionId], references: [id])
  taskCode     String
  taskTitle    String
  delta        Int
  reason       String
  createdAt    DateTime   @default(now())

  @@index([userId])
}

model Reward {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  description    String
  tierGate       Tier
  signalGate     Int           @default(0)
  fulfilmentType FulfilmentType
  grants         RewardGrant[]
}

model RewardGrant {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  rewardId    String
  reward      Reward      @relation(fields: [rewardId], references: [id])
  status      GrantStatus @default(locked)
  detail      String?
  earnedAt    DateTime?
  claimedAt   DateTime?
  fulfilledAt DateTime?
  createdAt   DateTime    @default(now())

  @@unique([userId, rewardId])
  @@index([status])
}

model Certificate {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  publicId        String    @unique
  issuedAt        DateTime  @default(now())
  /// Percentage, computed server-side from the accepted assessment attempt. Never from the
  /// client: the value used to arrive as `autoScore` straight out of the browser.
  assessmentScore Int
  revokedAt       DateTime?
  revokedById     String?
  revokedBy       User?     @relation("CertificateRevoker", fields: [revokedById], references: [id])
  revokeReason    String?
}

model LibraryModule {
  id       String @id @default(cuid())
  code     String @unique
  title    String
  summary  String
  bodyMd   String
  order    Int
  progress ModuleProgress[]
}

model ModuleProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  moduleId    String
  module      LibraryModule  @relation(fields: [moduleId], references: [id])
  completedAt DateTime?

  @@unique([userId, moduleId])
}

model Application {
  id         String            @id @default(cuid())
  name       String
  email      String
  campus     String
  city       String            @default("")
  field      String
  answerText  String
  status     ApplicationStatus @default(pending)
  createdAt  DateTime          @default(now())
  decidedById String?
  decidedBy  User?             @relation("ApplicationDecider", fields: [decidedById], references: [id])
  decidedAt  DateTime?
  /// Set when an acceptance provisions the ambassador account.
  userId     String?
  cohortId   String?
  cohort     Cohort?           @relation(fields: [cohortId], references: [id])

  @@index([email])
  @@index([status, createdAt])
}

model Announcement {
  id          String   @id @default(cuid())
  cohortId    String
  cohort      Cohort   @relation(fields: [cohortId], references: [id])
  bodyMd      String
  publishedAt DateTime @default(now())

  @@index([cohortId, publishedAt])
}

// ── Identity ────────────────────────────────────────────────────────────────
// The app owns its sessions. Supabase Auth was the original plan, but it needs SMTP
// configured in the dashboard to send anything, and every data-layer call site already
// goes through Prisma. So: a one-time code we issue, verified server-side, exchanged for a
// revocable session row.

model MagicLink {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  /// Consumption attempts, so a leaked-and-guessed token cannot be brute forced.
  attempts  Int       @default(0)

  @@index([email, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?

  @@index([userId])
}

// Anything that changes a person's standing, in one append-only place.
model AuditEvent {
  id       String   @id @default(cuid())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id])
  action   String
  target   String
  meta     Json     @default("{}")
  ip       String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([target])
}
